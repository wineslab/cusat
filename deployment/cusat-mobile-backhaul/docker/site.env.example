# Copy this file to site.env. Set addresses and ports that the Thor host can
# reach. A core on the same host normally uses ports 38412 (NGAP) and 8805 (PFCP).
CORE_AMF_IP=192.0.2.10
CORE_AMF_PORT=38412
CORE_SMF_PFCP_HOST=192.0.2.10
CORE_SMF_PFCP_PORT=8805

# These values must agree with the existing core and subscriber configuration.
PLMN_MCC=001
PLMN_MNC=05
PLMN_MNC_LENGTH=2
TRACKING_AREA_CODE=1
CORE_DNN=oai
CORE_UE_SUBNET=10.45.0.0/16
CORE_UE_GATEWAY=10.45.0.1

# Point-to-point addresses carried through cuSAT.
CUSAT_BOAT_IP=10.200.0.1
CUSAT_SHORE_IP=10.200.0.2

# Boat-side USRP. The YAML files remain the source of truth for DVB.
BOAT_USRP_ADDR=192.168.40.2

# Tested CPU partitions.
BOAT_DVB_CPUSET=4-11
BOAT_OAI_CPUSET=12-19
SHORE_DVB_CPUSET=4-11
SHORE_UPF_CPUSET=0-3
